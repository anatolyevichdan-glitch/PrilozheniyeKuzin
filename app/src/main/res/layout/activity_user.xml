<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/white" tools:context=".UserActivity">
    <ImageButton android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:src="@drawable/ic_back" android:background="?android:attr/selectableItemBackground" android:contentDescription="@string/back" android:onClick="Back" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:orientation="vertical">
        <EditText android:id="@+id/NameTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:inputType="text" android:hint="@string/name_hint" />
        <EditText android:id="@+id/AgeTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:inputType="number" android:hint="@string/age_hint" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="@drawable/back_smoke_round">
            <EditText android:id="@+id/StateTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="15dp" android:background="@android:color/transparent" android:inputType="textMultiLine" android:hint="@string/state_hint" />
        </FrameLayout>
    </LinearLayout>
    <Button android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/back_round_smoke_top" android:text="@string/save" android:textColor="@android:color/white" android:onClick="Save" />
</LinearLayout>
